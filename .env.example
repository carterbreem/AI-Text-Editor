# OCR is locked to Tesseract — runs locally, no API credits.
OCR_PROVIDER=tesseract

# Reserved for future use. Leave blank to keep zero paid dependencies.
GOOGLE_VISION_API_KEY=
REPLICATE_API_TOKEN=

# Qwen-Image-Edit (NVIDIA NIM) — server-side only, never expose to client.
NVIDIA_API_KEY=
QWEN_IMAGE_EDIT_ENDPOINT=https://integrate.api.nvidia.com/v1
